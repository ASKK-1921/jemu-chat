mixin createChatImage(chatData, userLoggedIn)
  if (!chatData)
    return
  - var i = 0
  - var maximumImagesToShow = 3
  - var remainingUsers = chatData.users.length - maximumImagesToShow
  - remainingUsers-- // Remove one since we won't show our own image
  .chatImagesContainer
    if (remainingUsers > 0)
      .userCount
        span +#{remainingUsers}
    each user in chatData.users
      if chatData.users.length != 1 && user._id == userLoggedIn
        - continue
      else if i >= maximumImagesToShow
        - break
      img(src=`${process.env.S3_URL}/${user.profilePicture}`, alt="User profile picture", title=user.firstName)
      - i++

mixin chatNameModal(chat)
  #chatNameModalCenter.modal(tabindex='-1', role='dialog', aria-labelledby='chatNameModalCenterTitle', aria-hidden='true')
    .modal-dialog.modal-dialog-centered(role='document')
      .modal-content
        .modal-header
          h5#chatNameModalLongTitle.modal-title Change the chat name?
          button.close(type='button', data-bs-dismiss='modal', aria-label='Close')
            span(aria-hidden='true') &times;
        .modal-body
          input#chatNameTextbox(type="text", placeholder='Enter a name for this chat', value=chat.chatName)
        .modal-footer
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Cancel
          button#chatNameButton.btn.btn-primary(type='button') Save

mixin icon(name)
  span.material-symbols-outlined #{name}

mixin myDetailsArea()
  #myDetailsArea
    .userImageContainer
      img(src=`${process.env.S3_URL}/${userLoggedIn.profilePicture}` alt='profile picture')
    .userDetailsContainer
      .header
        span.myName #{userLoggedIn.firstName}
        span.username @#{userLoggedIn.username}