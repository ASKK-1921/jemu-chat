extends layouts/main-layout.pug 

block content
  if !profileUser
    span.errorMessage User not found
  else
  
    .tabsContainer(data-tab=selectedTab data-pid=profileUser._id)
      +createTab("Following", `/profile/${profileUser.username}/following`, selectedTab != 'followers')
      +createTab("Followers", `/profile/${profileUser.username}/followers`, selectedTab == 'followers')
    .resultsContainer#followersAndFollowingContainer